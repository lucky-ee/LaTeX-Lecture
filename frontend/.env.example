# Copy to .env.development.local / .env.production.local (both gitignored) as needed.
# Vite picks the file by mode: `npm run dev` -> development, `npm run build` -> production.

# Backend base URL baked into the build. Leave empty to call the same origin
# (Vite dev proxy locally, or a reverse proxy in production).
# Example (prod, separate API host): VITE_API_URL=https://api.example.com
VITE_API_URL=

# Dev server only: where the /api proxy forwards to.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
